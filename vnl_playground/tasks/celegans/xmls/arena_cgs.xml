<mujoco>
  <compiler angle="degree" coordinate="local" inertiafromgeom="true" meshdir="./meshes" />
  <option gravity="0 0 -981" density="0.00128" viscosity="0.000185" integrator="Euler" cone="elliptic" solver="CG" iterations="6" ls_iterations="6"/>
  <visual>
    <headlight diffuse=".5 .5 .5" specular="1 1 1"/>
    <global offwidth="2048" offheight="1536"/>
    <quality shadowsize="8192"/>
  </visual>

  <asset>
    <!-- <skin name="skin" file="rodent_walker_skin.skn"/> -->
    <texture name="grid" type="2d" builtin="checker" width="64" height="64" rgb1=".1 .2 .3" rgb2=".2 .3 .4"/>
    <material name="grid" texture="grid" texrepeat=".1 .1" texuniform="true" reflectance=".2"/>
  </asset>

  <worldbody>
    <geom contype="1" conaffinity="0" name="floor" pos="0 0 -0.0005" size="3 3 0.0005" type="plane" material="grid"/>
  </worldbody>
</mujoco>