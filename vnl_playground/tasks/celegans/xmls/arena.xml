<mujoco>
  <compiler angle="degree" coordinate="local" inertiafromgeom="true" meshdir="./meshes" />
  <option density="1.2" solver="CG" iterations="6" ls_iterations="6" timestep="0.002" viscosity="0.1" cone="elliptic"/>
  <visual>
    <headlight diffuse=".5 .5 .5" specular="1 1 1"/>
    <global offwidth="2048" offheight="1536"/>
    <quality shadowsize="8192"/>
  </visual>

  <asset>
    <!-- <skin name="skin" file="rodent_walker_skin.skn"/> -->
    <texture name="grid" type="2d" builtin="checker" width="512" height="512" rgb1=".1 .2 .3" rgb2=".2 .3 .4"/>
    <material name="grid" texture="grid" texrepeat="1 1" texuniform="true" reflectance=".2"/>
  </asset>

  <worldbody>
    <geom contype="0" conaffinity="1" name="floor" pos="0 0 -0.005" size="10 10 0.005" type="plane" material="grid"/>
  </worldbody>
</mujoco>